GD1 -[#808080,thickness=5]right-> GD2 : subViewReport
GD2 -[#808080,thickness=5]down-> GD3 : subContinue
GD3 -[#808080,thickness=5]down-> GD4 : outsubMovieStatList
GD4 -[#808080,thickness=5]down-> GD5 : outsubShowtimeStatList
@enduml
