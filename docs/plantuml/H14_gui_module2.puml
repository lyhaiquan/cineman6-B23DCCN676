@startuml H14_gui_module2
' Hinh 14 - Thiet ke giao dien modul xem thong ke phim theo doanh thu - B23DCCN676 - De 16
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam nodesep 35
skinparam ranksep 35
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #FFFFFF
}

rectangle GD1 [
{{
salt
{+
  <b>CINEMAN — Trang chủ quản lí
  .
  Quản lí phim      Quản lí lịch chiếu
  .
  <b>Xem báo cáo   <color:#777777>subViewReport : link
  .
}
}}
]

rectangle GD2 [
{{
salt
{+
  <b>Chọn loại thống kê
  .
  {
    Loại thống kê | ^Thống kê phim theo doanh thu^ | <color:#777777>inoutReportType
  }
  .
  {
    [  Tiếp tục  ] | <color:#777777>subContinue | [  Quay lại  ] | <color:#777777>subBack
  }
}
}}
]

rectangle GD3 [
{{
salt
